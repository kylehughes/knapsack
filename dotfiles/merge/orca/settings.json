{
  "agentDefaultArgs": {
    "aider": "--yes-always",
    "amp": "--dangerously-allow-all",
    "ante": "--yolo",
    "antigravity": "--dangerously-skip-permissions",
    "autohand": "--unrestricted",
    "claude": "--dangerously-skip-permissions",
    "claude-agent-teams": "--dangerously-skip-permissions",
    "cline": "--auto-approve true",
    "codex": "--dangerously-bypass-approvals-and-sandbox",
    "command-code": "--yolo",
    "continue": "--allow \"*\"",
    "copilot": "--yolo",
    "crush": "--yolo",
    "cursor": "--yolo",
    "devin": "--permission-mode bypass --respect-workspace-trust false",
    "droid": "--auto high",
    "gemini": "--yolo",
    "grok": "--permission-mode bypassPermissions",
    "hermes": "--yolo",
    "kimi": "--yolo",
    "kiro": "--trust-all-tools",
    "mistral-vibe": "--agent auto-approve",
    "openclaude": "--dangerously-skip-permissions",
    "qwen-code": "--approval-mode yolo",
    "rovo": "--yolo",
    "trae": "--yolo"
  },
  "agentDefaultEnv": {
    "goose": {
      "GOOSE_MODE": "auto"
    }
  },
  "autoRenameBranchFromWork": false,
  "branchPrefix": "git-username",
  "claudeAgentTeamsMode": "off",
  "ctrlTabOrderMode": "mru",
  "defaultTaskSource": "github",
  "defaultTuiAgent": "claude",
  "diffDefaultView": "inline",
  "diffShowWhitespace": false,
  "diffWordWrap": false,
  "disabledTuiAgents": [
    "cursor",
    "gemini",
    "opencode",
    "claude-agent-teams"
  ],
  "editorAutoSave": false,
  "editorMinimapEnabled": false,
  "editorWordWrap": true,
  "experimentalNativeChat": true,
  "notifications": {
    "agentTaskComplete": true,
    "customSoundId": "system",
    "customSoundPath": null,
    "customSoundVolume": 100,
    "enabled": true,
    "suppressWhenFocused": true,
    "terminalBell": false
  },
  "openInApplications": [
    {
      "command": "zed",
      "id": "zed",
      "label": "Zed"
    }
  ],
  "promptCacheTimerEnabled": true,
  "refreshLocalBaseRefOnWorktreeCreate": false,
  "rightSidebarOpenByDefault": true,
  "showArtifactsButton": false,
  "showAutomationsButton": true,
  "showGitIgnoredFiles": true,
  "showMenuBarIcon": true,
  "showMobileButton": true,
  "showSkillsButton": false,
  "showTasksButton": true,
  "showTitlebarAppName": true,
  "sourceControlGroupOrder": "changes-first",
  "sourceControlViewMode": "list",
  "terminalColorOverrides": {
    "background": "#1c1c1c",
    "black": "#1c1c1c",
    "blue": "#8787ff",
    "brightBlack": "#444444",
    "brightBlue": "#afafff",
    "brightCyan": "#afd7d7",
    "brightGreen": "#afd7af",
    "brightMagenta": "#d7afff",
    "brightRed": "#ff87af",
    "brightWhite": "#eeeeee",
    "brightYellow": "#e7cfff",
    "cursor": "#d7afff",
    "cursorAccent": "#1c1c1c",
    "cyan": "#87d7d7",
    "foreground": "#eeeeee",
    "green": "#87d787",
    "magenta": "#af5fff",
    "red": "#ff5f87",
    "selectionBackground": "#af5fff",
    "selectionForeground": "#eeeeee",
    "white": "#d0d0d0",
    "yellow": "#d7afff"
  },
  "terminalCursorBlink": true,
  "terminalCursorStyle": "block",
  "terminalDividerThicknessPx": 3,
  "terminalFontFamily": "SF Mono",
  "terminalFontSize": 14,
  "terminalFontWeight": 500,
  "terminalFontWeightBold": 700,
  "terminalLineHeight": 1,
  "terminalLinkClickBehavior": "actions",
  "terminalMacOptionAsAlt": "true",
  "terminalPaddingX": 10,
  "terminalPaddingY": 10,
  "terminalScrollSensitivity": 1.15,
  "terminalScrollbackRows": 10000,
  "terminalShortcutPolicy": "orca-first",
  "terminalThemeDark": "Ghostty Default Style Dark",
  "terminalThemeLight": "Builtin Tango Light",
  "terminalUseSeparateLightTheme": true,
  "theme": "system",
  "visibleTaskProviders": [
    "github",
    "gitlab",
    "linear",
    "jira"
  ],
  "voice": {
    "dictationMode": "toggle",
    "enabled": true,
    "language": "en",
    "sttModel": "parakeet-tdt-0.6b-v2-int8",
    "terminalConfirmBeforeInsert": false
  },
  "worktreeVisibilityDefaults": {
    "external": "hide"
  }
}
